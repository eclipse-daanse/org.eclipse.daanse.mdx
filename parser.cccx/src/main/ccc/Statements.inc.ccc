{
  public java.util.List<CompoundId> properties() {
     return childrenOfType(CompoundId.class);
  }
}

SelectDimensionPropertyListClause :
  (< DIMENSION >)?
  < PROPERTIES >
  CompoundId
  (
    < COMMA >
    CompoundId
  )*
;

INJECT RefreshStatement :
   implements MdxStatement, org.eclipse.daanse.mdx.model.api.RefreshStatement;
{
   public NameObjectIdentifier cubeName() {
      return (NameObjectIdentifier) get(2);
   }
}

RefreshStatement :
  < REFRESH >
  < CUBE >
  NameObjectIdentifier
;

INJECT TransactionStatement :
   implements MdxStatement, org.eclipse.daanse.mdx.model.api.TransactionStatement;
{
   public org.eclipse.daanse.mdx.model.api.TransactionKind kind() {
      NodeType type = getFirstChild().getType();
      if (type == BEGIN) return org.eclipse.daanse.mdx.model.api.TransactionKind.BEGIN;
      if (type == COMMIT) return org.eclipse.daanse.mdx.model.api.TransactionKind.COMMIT;
      if (type == ROLLBACK) return org.eclipse.daanse.mdx.model.api.TransactionKind.ROLLBACK;
      throw new IllegalStateException("Transaction kind parsing error");
   }
}

TransactionStatement :
  (
    < BEGIN >
    |
    < COMMIT >
    |
    < ROLLBACK >
  )
  // TRAN is the abbreviation every client that sends the long form also accepts.
  ( < TRANSACTION > | < TRAN > )
;

// Session statements, as SSAS takes them in an XMLA Execute. The first segment of the name is always the cube.
//
// <createMemberStatement> ::= CREATE [SESSION] [CALCULATED] MEMBER <cubeReference> . <memberName>
//                               AS <expression> [ , <identifier> = <expression> ]...
// <createSetStatement>    ::= CREATE [SESSION] [STATIC | DYNAMIC] [HIDDEN] SET <cubeReference> . <setName>
//                               AS <expression> [ , <identifier> = <expression> ]...
// <dropMemberStatement>   ::= DROP MEMBER <qualifiedName> [ , <qualifiedName> ]...
// <dropSetStatement>      ::= DROP SET <qualifiedName> [ , <qualifiedName> ]...
// <qualifiedName>         ::= <cubeReference> . <compoundId>
// <cubeReference>         ::= <identifier> | CURRENTCUBE
//
// CREATE, DROP, SESSION, CALCULATED, STATIC, DYNAMIC, HIDDEN and CURRENTCUBE are words, not tokens: they stay names
// elsewhere. The cube is the NameObjectIdentifier right after MEMBER or SET.

INJECT CreateMemberStatement :
   import static org.eclipse.daanse.mdx.parser.cccx.MdxParserUtil.cubeReference;
   import static org.eclipse.daanse.mdx.parser.cccx.MdxParserUtil.hasWordBefore;
   implements MdxStatement, org.eclipse.daanse.mdx.model.api.CreateMemberStatement;
{
   public boolean session() {
      return hasWordBefore(this, MEMBER, "SESSION");
   }

   public boolean calculated() {
      return hasWordBefore(this, MEMBER, "CALCULATED");
   }

   public org.eclipse.daanse.mdx.model.api.CubeReference cube() {
      return cubeReference((NameObjectIdentifier) firstChildOfType(MEMBER).nextSibling());
   }

   public org.eclipse.daanse.mdx.model.api.select.CreateMemberBodyClause body() {
      return firstChildOfType(CreateMemberBodyClause.class);
   }
}

// https://learn.microsoft.com/en-us/sql/mdx/mdx-data-definition-create-member?view=sql-server-ver16
CreateMemberStatement :
  SCAN {isWord(1, "CREATE")} => < ID >
  ( SCAN {isWord(1, "SESSION")} => < ID > )?
  ( SCAN {isWord(1, "CALCULATED")} => < ID > )?
  < MEMBER > NameObjectIdentifier < DOT > CreateMemberBodyClause
;

INJECT CreateSetStatement :
   import java.util.Optional;
   import org.eclipse.daanse.mdx.model.api.SetEvaluation;
   import static org.eclipse.daanse.mdx.parser.cccx.MdxParserUtil.cubeReference;
   import static org.eclipse.daanse.mdx.parser.cccx.MdxParserUtil.hasWordBefore;
   implements MdxStatement, org.eclipse.daanse.mdx.model.api.CreateSetStatement;
{
   public boolean session() {
      return hasWordBefore(this, SET, "SESSION");
   }

   public Optional<SetEvaluation> evaluation() {
      if (hasWordBefore(this, SET, "STATIC")) return Optional.of(SetEvaluation.STATIC);
      if (hasWordBefore(this, SET, "DYNAMIC")) return Optional.of(SetEvaluation.DYNAMIC);
      return Optional.empty();
   }

   public boolean hidden() {
      return hasWordBefore(this, SET, "HIDDEN");
   }

   public org.eclipse.daanse.mdx.model.api.CubeReference cube() {
      return cubeReference((NameObjectIdentifier) firstChildOfType(SET).nextSibling());
   }

   public org.eclipse.daanse.mdx.model.api.select.CreateSetBodyClause body() {
      return firstChildOfType(CreateSetBodyClause.class);
   }
}

// https://learn.microsoft.com/en-us/sql/mdx/mdx-data-definition-create-set?view=sql-server-ver16
CreateSetStatement :
  SCAN {isWord(1, "CREATE")} => < ID >
  ( SCAN {isWord(1, "SESSION")} => < ID > )?
  (
    SCAN {isWord(1, "STATIC")} => < ID >
  |
    SCAN {isWord(1, "DYNAMIC")} => < ID >
  )?
  ( SCAN {isWord(1, "HIDDEN")} => < ID > )?
  < SET > NameObjectIdentifier < DOT > CreateSetBodyClause
;

