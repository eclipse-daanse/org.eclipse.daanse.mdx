    < WITH > (SelectWithClause)+
  )?
  < SELECT >
  (
    SelectQueryAsteriskClause
    |
    SelectQueryAxesClause
    |
    SelectQueryEmptyClause
  )?
  < FROM >
  SelectCubeClause
  (
    SelectSlicerAxisClause
