SelectCubeClauseSubStatement :
  < LPAREN > { checkNesting(); }
  < SELECT >
  (
    SelectQueryClause
  )?
  < FROM >
  SelectCubeClause
  (
    SelectSlicerAxisClause
  )?
  < RPAREN >
;

